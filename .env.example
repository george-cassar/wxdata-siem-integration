# =============================================================================
# watsonx.data Presto ↔ SIEM Integration Demo — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# --- Demo Mode ---------------------------------------------------------------
# "mock"  : all data is synthetic; no watsonx.data connection required
# "live"  : queries run against real watsonx.data Presto
DEMO_MODE=mock

PORT=8000
HOST=0.0.0.0

# --- watsonx.data Presto Connection ------------------------------------------
# Hostname of your watsonx.data Presto coordinator (IBM Cloud SaaS or on-prem).
# In mock mode these are ignored — all events are synthetic.
PRESTO_HOST=localhost
PRESTO_PORT=8443
PRESTO_USE_SSL=false
# Set to "false" to skip TLS verification for self-signed certificates
PRESTO_SSL_VERIFY=false

# Authentication — choose ONE method:
# Option A: Username + Password (Basic Auth)
#   The backend exchanges these for a CP4D bearer token automatically.
PRESTO_USER=ibmacp
PRESTO_PASSWORD=

# Option B: JWT Bearer Token (preferred)
#   Pre-obtained CP4D access token — no password exchange needed.
PRESTO_BEARER_TOKEN=

# CP4D console hostname used for token exchange (defaults to PRESTO_HOST)
PRESTO_CPD_HOST=

# Catalog & schema that the demo SQL targets (session defaults / fallback)
PRESTO_CATALOG=iceberg_data
PRESTO_SCHEMA=finance

# Source tag sent in the X-Presto-Source header for auditing
PRESTO_SOURCE_TAG=watsonx-data-siem-demo

# X-Presto-User used for audit queries (system.runtime.queries and
# wxd_system_data diagnostic view).  On watsonx.data CP4D these views enforce
# row-level security based on X-Presto-User — only that user's own queries are
# returned unless a privileged service account is used.
# "ibmlhapiuser" is the built-in CP4D account with global query visibility.
# Set to the same value as PRESTO_USER to see only that user's queries.
PRESTO_AUDIT_USER=ibmlhapiuser

# How many hours back the audit history query looks in wxd_system_data.
# Increase this to surface older queries (costs more scan time).
AUDIT_HISTORY_HOURS=24

# --- Presto Polling Behaviour ------------------------------------------------
# Hard wall-clock budget (seconds) for the httpx polling loop.
# Must stay well under the frontend's 90 s axios timeout.
PRESTO_POLL_WALL_LIMIT_S=75
# Pause between nextUri poll calls (seconds)
PRESTO_POLL_INTERVAL_S=0.2
# Maximum rows returned per query to the UI (safety cap)
PRESTO_MAX_ROWS_UI=500

# --- Engine & Cluster Metadata -----------------------------------------------
# Version string embedded in every SIEM audit event payload.
ENGINE_VERSION=Presto (Java) 0.286
# Cluster name reported in SIEM events.
# Defaults to the first hostname segment of PRESTO_HOST when left blank.
CLUSTER_NAME=

# --- SIEM Event Payload Tuning -----------------------------------------------
# Multiplier applied to wall-clock duration to estimate cpuTimeMs
CPU_TIME_MULTIPLIER=1.8

# Vendor / product strings embedded in every LEEF and CEF payload
SIEM_VENDOR=IBM
SIEM_PRODUCT=watsonx.data
SIEM_PRODUCT_VERSION=2.0.1

# Maximum SQL text length (characters) included in a CEF msg field
SIEM_CEF_SQL_SNIPPET_LEN=120
# Maximum SQL text length (characters) included in a SIEM offense sqlSnippet
SIEM_OFFENSE_SQL_SNIPPET_LEN=140

# --- SIEM Configuration ------------------------------------------------------
SIEM_SIMULATION_ENABLED=true
# Optional: forward LEEF/CEF events to a real SIEM (QRadar, Splunk, Sentinel)
SIEM_FORWARD_HOST=
SIEM_FORWARD_PORT=514
SIEM_FORWARD_PROTOCOL=UDP
SIEM_FORMAT=LEEF_2_0

# --- SIEM Correlation Rule Thresholds ----------------------------------------
# Rule 1001 fires when a single query reads more than these limits
RULE_EXFIL_ROW_THRESHOLD=100000
RULE_EXFIL_BYTES_THRESHOLD=50000000

# --- In-Memory Ring Buffers --------------------------------------------------
# Maximum events and offenses kept in the backend in-memory store
SIEM_EVENT_BUFFER_SIZE=500
SIEM_OFFENSE_BUFFER_SIZE=30

# --- Mock-Mode Synthetic Baseline --------------------------------------------
# Added to KPI totals in mock mode so the demo dashboard looks realistic
MOCK_BASELINE_EVENTS=1420
MOCK_BASELINE_BYTES=4820000000
MOCK_BASELINE_ROWS=12500000
MOCK_BASELINE_EPS=14.2 eps

# --- Offense Formatting ------------------------------------------------------
OFFENSE_ID_PREFIX=SEC-OFF
OFFENSE_ID_START=101
OFFENSE_ASSIGNED_ANALYST=SOC Tier 2 / Auto-Triage

# --- Frontend Query Studio Defaults ------------------------------------------
# Pre-filled values shown in the Query Studio on first load.
# All are fully editable by the user at runtime.
DEFAULT_QUERY_USER=analyst_sarah
DEFAULT_QUERY_CLIENT_IP=10.244.12.45
# Use {catalog} and {schema} as placeholders — they are replaced at runtime.
DEFAULT_QUERY_SQL=SELECT customer_region, count(*) as tx_count, sum(amount) as total_volume_usd\nFROM {catalog}.{schema}.transactions\nGROUP BY customer_region

# --- Frontend Dashboard Behaviour --------------------------------------------
# Number of events fetched on initial dashboard load
DASHBOARD_INITIAL_EVENT_COUNT=30
# Client-side ring-buffer sizes for live WebSocket events and offenses
WS_EVENT_RING_SIZE=50
WS_OFFENSE_RING_SIZE=30

# --- Frontend ----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEMO_TITLE="watsonx.data Presto & SIEM Integration Console"
VITE_DEMO_CLIENT_CODE=DEMO-WXD-SIEM
